{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ecosapiens",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    {
      "pattern": "ecosapiensit.com.br",
      "custom_domain": true
    },
    {
      "pattern": "www.ecosapiensit.com.br",
      "custom_domain": true
    }
  ]
}
